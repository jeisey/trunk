    "claims": [
      {
        "id": "clm.core.tummy-awake-supervised",
        "kind": "safety",
        "text": "Tummy time is only for when your baby is awake and an adult is watching closely the whole time.",
        "sources": [
          "src.aap-hc.back-to-sleep-tummy-to-play"
        ],
        "locator": "AAP Back to Sleep: 'The basics of safe sleep & tummy time', item 2; HSE: 'Safety' do-list; AAP safe sleep guide: tummy time section",
        "paraphrase": "AAP describes tummy time as for babies who are awake and closely supervised, and says an awake adult should supervise. HSE says always stay with your baby and keep them awake and supervised on their tummy.",
        "scope": "All infants; US (AAP) and Ireland (HSE) public guidance agree."
      },
      {
        "id": "clm.core.tummy-builds-strength",
        "kind": "description",
        "text": "Tummy time helps babies build the neck, shoulder, and back strength they use for rolling, sitting, and crawling.",
        "sources": [
          "src.aap-hc.back-to-sleep-tummy-to-play"
        ],
        "locator": "AAP Back to Sleep: 'Tummy to play'; HSE: opening paragraph; Children's Wisconsin: 'Why is tummy time important?'",
        "paraphrase": "All three describe tummy time as building muscles babies need to roll, sit, and crawl; Children's Wisconsin adds back, neck, and shoulder muscles and using eyes and hands together.",
        "scope": "General infant guidance; describes purpose, not a guaranteed outcome or timeline."
      }
    ],

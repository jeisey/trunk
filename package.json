{
  "name": "trunk",
  "private": true,
  "version": "1.0.0",
  "description": "Trunk — a little help for the next hour. A practical activity finder for parents of children under five.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "content": "node scripts/build-catalog.ts",
    "validate:content": "node scripts/build-catalog.ts --check",
    "typecheck": "node scripts/build-catalog.ts && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "check": "npm run typecheck && vitest run",
    "pretest": "node scripts/build-catalog.ts",
    "serve:subpath": "node e2e/serve.mjs",
    "predev": "node scripts/build-catalog.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
